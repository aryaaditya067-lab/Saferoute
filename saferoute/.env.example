# Base URL of the SafeRoute Java Spring Boot backend (../saferoute-backend).
# Set it to enable reported-crime areas and Fastest / Balanced / Safest routes:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Leave empty to call the public OpenStreetMap services (Photon + OSRM) directly
# from the browser, without any safety features.
NEXT_PUBLIC_API_BASE_URL=

# Optional overrides for the public providers used when no backend is configured.
# NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io
# NEXT_PUBLIC_ROUTER_URL=https://routing.openstreetmap.de
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
